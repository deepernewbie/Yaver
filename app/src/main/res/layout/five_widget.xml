<?xml version="1.0" encoding="utf-8"?>
<!-- yaver 5 home-screen widget (RemoteViews: only LinearLayout / TextView / ImageView are used) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/five_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/five_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/five_w_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/five_widget_brand"
            android:textColor="@color/five_w_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/five_w_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/five_w_text2"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/five_w_meet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/five_widget_row"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <TextView
            android:id="@+id/five_w_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/five_w_accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/five_w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/five_widget_loading"
            android:textColor="@color/five_w_text"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/five_w_mail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/five_widget_row"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="2dp"
        android:paddingTop="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="4dp"
        android:textColor="@color/five_w_text2"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/five_w_ask"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/five_widget_btn"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/five_widget_ask"
            android:textColor="@color/five_w_on_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/five_w_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/five_widget_mic_bg"
            android:contentDescription="@string/five_widget_voice"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/five_ic_mic" />
    </LinearLayout>
</LinearLayout>
